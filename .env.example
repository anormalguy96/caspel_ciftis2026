# ============================================================
# CASPEL CIFTIS 2026 — environment
#
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env
# ============================================================

# --- Application ---------------------------------------------------
# production | development | test
# With APP_ENV=production the backend refuses to start unless every value
# below is genuinely production-ready. See Settings.production_problems().
APP_ENV=production
# Bound to 127.0.0.1 by docker-compose; the host nginx vhost is the only
# public entry point.
APP_HTTP_PORT=8080

# --- PostgreSQL ----------------------------------------------------
# Required. There is no fallback password anywhere in the code.
# Production requires at least 16 characters.
POSTGRES_DB=ciftis
POSTGRES_USER=ciftis
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Leave blank to have it composed from the values above.
DATABASE_URL=

# --- CASPEL AI (Google Gemini) -------------------------------------
# Required in production. The browser never contacts Google directly — only
# this server does, which is what keeps the page working from China.
GEMINI_API_KEY=
# Chat generation model. Chosen here, never by the application — there is no
# automatic fallback, so a failure on this model is reported as an outage.
# Moving to CASPEL's own paid key needs only: set GEMINI_API_KEY above, set
# this line if a different model is wanted, then `docker compose up -d backend`.
# No source change is involved.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Embedding model. Changing this invalidates every stored vector and requires
# a full re-ingestion, so it is not interchangeable with the chat model above.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
RAG_SIMILARITY_THRESHOLD=0.70
# Local development only. Must stay false in any deployed stack: /api/ready
# refuses to report ready while it is on, and production start-up refuses too.
ALLOW_MOCK_RAG=false

# --- Security ------------------------------------------------------
# Comma-separated origins. Leave empty for the normal same-origin deploy
# where nginx serves the SPA and proxies /api.
CORS_ALLOWED_ORIGINS=

# How many reverse proxies sit in front of the app. The rate limiter reads
# the Nth-from-the-right X-Forwarded-For entry, so a client cannot forge its
# own identity by prepending an address. One for the compose stack.
TRUSTED_PROXY_COUNT=1

# slowapi syntax, e.g. "10/hour", "20/minute".
RATE_LIMIT_LEADS=10/hour
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_EVENTS=120/minute

# --- Frontend (baked in at build time) -----------------------------
# Deployment mode. Pick ONE; both values must agree or the build fails.
#
#   Mode A — dedicated subdomain
#     VITE_APP_BASE_PATH=/
#     VITE_PUBLIC_URL=https://ciftis.caspel.com
#
#   Mode B — beneath the corporate site
#     VITE_APP_BASE_PATH=/ciftis/
#     VITE_PUBLIC_URL=https://caspel.com/ciftis
#
# Neither is a secret; both appear verbatim in the shipped HTML. Changing mode
# requires rebuilding the frontend image, never a source edit.
VITE_APP_BASE_PATH=/
VITE_PUBLIC_URL=https://ciftis.caspel.com
# Booth display idle reset, in seconds.
VITE_DISPLAY_RESET_SECONDS=25

# --- Presentations -------------------------------------------------
# Container mount for data/presentations. Only files matching an approved
# SHA256 in backend/app/core/presentations.py are ever served or ingested.
DATA_PRESENTATIONS_DIR=/data/presentations

# Environment Configuration for CASPEL CIFTIS 2026

APP_ENV=development
APP_HTTP_PORT=8080

# PostgreSQL Database Configuration
POSTGRES_DB=ciftis
POSTGRES_USER=ciftis
POSTGRES_PASSWORD=ciftis_secret_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ciftis:ciftis_secret_password_2026@postgres:5432/ciftis

# Gemini AI / RAG Configuration
# The API key must remain strictly server-side (never exposed to browser)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Frontend Configuration
VITE_PUBLIC_CIFTIS_URL=http://localhost:8080/ciftis
VITE_DISPLAY_RESET_SECONDS=25
